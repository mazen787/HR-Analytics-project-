      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([employee_id]) / TOTAL(COUNT([employee_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MIN(0)' datatype='integer' name='[Calculation_1166922075533313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0)' />
      </column>
      <column caption='Active Employees' datatype='integer' datatype-customized='true' name='[Calculation_1343942294978560]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(IF [attrition_flag] = 0 THEN [employee_id] END)' />
      </column>
      <column caption='Filter - Review Year' datatype='boolean' name='[Calculation_1958296172580864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = 0 OR YEAR([review_date]) = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Lost High Performers (Fix)' datatype='string' name='[Calculation_1958296186396673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [performance_score] &gt;= 4 AND [attrition_flag] = 1 &#13;&#10;AND (YEAR([exit_date]) = [Parameters].[Parameter 1] OR [Parameters].[Parameter 1] = 0)&#13;&#10;THEN [employee_id] &#13;&#10;END' />
      </column>
      <column caption='Leavers Count (Fix)' datatype='string' name='[Calculation_1958296192843778]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [attrition_flag] = 1 AND &#13;&#10;([Parameters].[Parameter 1] = 0 OR YEAR([exit_date]) = [Parameters].[Parameter 1])&#13;&#10;THEN [employee_id] &#13;&#10;END' />
      </column>
      <column caption='Filter - HR Headcount' datatype='boolean' name='[Calculation_1958296193282051]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = 0 OR &#13;&#10;(YEAR([hire_date]) &lt;= [Parameters].[Parameter 1] &#13;&#10;AND (ISNULL([exit_date]) OR YEAR([exit_date]) &gt;= [Parameters].[Parameter 1]))' />
      </column>
      <column caption='True Attrition Rate' datatype='real' name='[Calculation_1958296205795332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [attrition_flag] = 1 THEN [employee_id] END) &#13;&#10;/ &#13;&#10;COUNTD([employee_id])' />
      </column>
      <column caption='Filter - Attendance Year' datatype='boolean' name='[Calculation_1958296207945733]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = 0 OR YEAR([month_year]) = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Filter - Engagement Year' datatype='boolean' name='[Calculation_1958296208797702]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = 0 OR YEAR([survey_date]) = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1958296248647687]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age_years] &lt; 25 THEN &apos;&lt; 25&apos;&#13;&#10;ELSEIF [age_years] &gt;= 25 AND [age_years] &lt;= 34 THEN &apos;25 - 34&apos;&#13;&#10;ELSEIF [age_years] &gt;= 35 AND [age_years] &lt;= 44 THEN &apos;35 - 44&apos;&#13;&#10;ELSEIF [age_years] &gt;= 45 AND [age_years] &lt;= 54 THEN &apos;45 - 54&apos;&#13;&#10;ELSE &apos;55+&apos;&#13;&#10;END' />
      </column>
      <column caption='Color - Max Age Attrition' datatype='boolean' name='[Calculation_1958296275869704]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1958296205795332] = WINDOW_MAX([Calculation_1958296205795332])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Color - Max Overtime WLB' datatype='boolean' name='[Calculation_1958296287301641]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([overtime_ratio_pct]) = WINDOW_MAX(AVG([overtime_ratio_pct]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top Value Highlight' datatype='string' name='[Calculation_1958296303050762]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([annual_bonus_egp]) = WINDOW_MAX(AVG([annual_bonus_egp])) &#13;&#10;THEN &apos;Top&apos; &#13;&#10;ELSE &apos;Other&apos; &#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='None' caption='Tenure Years (bin)' datatype='integer' name='[Tenure Years (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[tenure_years]' peg='0' size='1' />
      </column>
