    <worksheet name='Gender Mix'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#05ffff' fontname='Benton Sans Book' fontsize='10'>Attrition by Age</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Dim_Employees_Final+ (HR_project)' name='federated.1fdm2i500g343d19hefhi18nhucf' />
          </datasources>
          <datasource-dependencies datasource='federated.1fdm2i500g343d19hefhi18nhucf'>
            <column caption='True Attrition Rate' datatype='real' name='[Calculation_1958296205795332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [attrition_flag] = 1 THEN [employee_id] END) &#13;&#10;/ &#13;&#10;COUNTD([employee_id])' />
            </column>
            <column caption='Age Group' datatype='string' name='[Calculation_1958296248647687]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [age_years] &lt; 25 THEN &apos;&lt; 25&apos;&#13;&#10;ELSEIF [age_years] &gt;= 25 AND [age_years] &lt;= 34 THEN &apos;25 - 34&apos;&#13;&#10;ELSEIF [age_years] &gt;= 35 AND [age_years] &lt;= 44 THEN &apos;35 - 44&apos;&#13;&#10;ELSEIF [age_years] &gt;= 45 AND [age_years] &lt;= 54 THEN &apos;45 - 54&apos;&#13;&#10;ELSE &apos;55+&apos;&#13;&#10;END' />
            </column>
            <column caption='Color - Max Age Attrition' datatype='boolean' name='[Calculation_1958296275869704]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1958296205795332] = WINDOW_MAX([Calculation_1958296205795332])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Age Years' datatype='real' name='[age_years]' role='measure' type='quantitative' />
            <column caption='Attrition Flag' datatype='integer' datatype-customized='true' name='[attrition_flag]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='Still work' />
                <alias key='1' value='Left' />
              </aliases>
            </column>
            <column caption='Employee Id' datatype='string' datatype-customized='true' name='[employee_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1958296248647687]' derivation='None' name='[none:Calculation_1958296248647687:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1958296205795332]' derivation='User' name='[usr:Calculation_1958296205795332:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1958296275869704]' derivation='User' name='[usr:Calculation_1958296275869704:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <manual-sort column='[federated.1fdm2i500g343d19hefhi18nhucf].[none:Calculation_1958296248647687:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;&lt; 25&quot;</bucket>
              <bucket>&quot;25 - 34&quot;</bucket>
              <bucket>&quot;35 - 44&quot;</bucket>
              <bucket>&quot;45 - 54&quot;</bucket>
              <bucket>&quot;55+&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
